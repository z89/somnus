<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>Label</key>
	<string>com.z89.somnus.helper</string>

	<key>BundleProgram</key>
	<string>Contents/MacOS/somnusd</string>

	<!-- SleepDisabled survives a reboot. Starting at boot lets the watchdog
	     restore Normal Sleep if the app never reports in after a restart. -->
	<key>RunAtLoad</key>
	<true/>

	<key>MachServices</key>
	<dict>
		<key>com.z89.somnus.helper</key>
		<true/>
	</dict>

	<key>AssociatedBundleIdentifiers</key>
	<array>
		<string>com.z89.somnus</string>
	</array>
</dict>
</plist>
